<?xml version="1.0" encoding="utf-8"?>
<!--
  Modo appcast — consumed by Sparkle in the installed app.

  Hosting: this file is uploaded as an asset on every GitHub release. The app
  fetches the file via the redirect URL
  https://github.com/varun-apps/Modo/releases/latest/download/appcast.xml,
  which always resolves to the asset attached to the most recent release.

  After running Distribution/release.sh, paste the printed <item> block at
  the top of <channel> below, then upload this file together with the .zip
  to the new GitHub release.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>Modo</title>
    <link>https://github.com/varun-apps/Modo</link>
    <description>Latest Modo releases</description>
    <language>en</language>

    <!-- Example item — replace VERSION/URL/SIGNATURE/LENGTH with values from release.sh
    <item>
      <title>Version 1.1</title>
      <sparkle:version>1.1</sparkle:version>
      <sparkle:shortVersionString>1.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <pubDate>Fri, 13 Jun 2026 12:00:00 +0000</pubDate>
      <description><![CDATA[
        <ul>
          <li>What changed in this release</li>
        </ul>
      ]]></description>
      <enclosure
        url="https://github.com/varun-apps/Modo/releases/download/v1.1/Modo-1.1.zip"
        sparkle:edSignature="…"
        length="…"
        type="application/octet-stream" />
    </item>
    -->
     <item>
      <title>Version 1.0</title>
      <sparkle:version>1.0</sparkle:version>
      <sparkle:shortVersionString>1.0</sparkle:shortVersionString>
