<?xml version="1.0" encoding="utf-8"?>
<!--
  Modo appcast — consumed by Sparkle in the installed app.

  Hosting: this file is uploaded as an asset on every GitHub release. The app
  fetches the file via the redirect URL
  https://github.com/varun-apps/Modo/releases/latest/download/appcast.xml,
  which always resolves to the asset attached to the most recent release.

  After running Distribution/release.sh, paste the printed <item> block at
  the top of <channel> below, then upload this file together with the .zip
  to the new GitHub release.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>Modo</title>
    <link>https://github.com/varun-apps/Modo</link>
    <description>Latest Modo releases</description>
    <language>en</language>


    <item>
      <title>Version 1.2</title>
      <sparkle:version>1.2</sparkle:version>
      <sparkle:shortVersionString>1.2</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <pubDate>Fri, 26 Jun 2026 17:03:04 +0000</pubDate>
      <description><![CDATA[
        <ul>
          <li>Redesigned popover: editable text input, primary tiles (Improve / Fix Grammar / Rephrase), secondary list with ⌘1–⌘9, arrow-key navigation</li>
          <li>Auto-update now uses GitHub's permanent latest-release redirect URL — no separately-hosted appcast needed</li>
          <li>Internal: capture pipeline scaffolding, observability hooks, single-instance guard, per-app policy hook</li>
        </ul>
      ]]></description>
      <enclosure
        url="https://github.com/varun-apps/Modo/releases/download/v1.2/Modo-1.2.zip"
        sparkle:edSignature="5X78Mx/UAtZJN44IQ5tbu70N8lIaNHtDRi/4yh+wdfODvlhu9uNDKjVHASwjTzv2NxH1MjOy/zu0se2s2OUIAQ=="
        length="2117561"
        type="application/octet-stream" />
    </item>
